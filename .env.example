# Copy to .env and adjust. Never commit a real .env.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://connect4:connect4@localhost:5432/connect4gg

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=dev-secret-change-me-in-production-please
# Where the browser app is served from; used for CORS and OAuth redirects.
CLIENT_ORIGIN=http://localhost:5173

# --- Google OAuth (optional in dev) -----------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials with
# redirect URI http://localhost:4000/api/auth/google/callback
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Avatar storage ---------------------------------------------------------
# "local" writes to UPLOAD_DIR; "s3" uses the S3_* settings below.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=connect4gg-avatars
S3_ACCESS_KEY_ID=connect4
S3_SECRET_ACCESS_KEY=connect4secret
# Public base URL objects are served from (CDN or bucket URL).
S3_PUBLIC_URL=http://localhost:9000/connect4gg-avatars

# --- Web (Vite) -------------------------------------------------------------
VITE_API_URL=http://localhost:4000
